PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/booknestdb?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5000

# Admin account (created on first seed)
ADMIN_EMAIL=admin@booknest.local
ADMIN_PASSWORD=AdminPass123!
ADMIN_FIRST_NAME=BookNest
ADMIN_LAST_NAME=Admin

# Email (Nodemailer) - use Gmail App Password or any SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=BookNest <noreply@booknest.local>

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
