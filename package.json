{
  "name": "booknest",
  "version": "1.0.0",
  "description": "BookNest — Smart Library & Book Marketplace (full-stack college project)",
  "main": "server/src/server.js",
  "scripts": {
    "start": "node server/src/server.js",
    "dev": "nodemon server/src/server.js",
    "seed": "node server/src/seed/seed.js",
    "test": "jest --runInBand --forceExit --detectOpenHandles"
  },
  "keywords": [
    "booknest",
    "library",
    "express",
    "mongodb"
  ],
  "nodemonConfig": {
    "watch": [
      "server/src",
      "html",
      "js",
      "css"
    ],
    "ext": "js,json,html,css",
    "ignore": [
      "server/src/uploads"
    ]
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "1.4.5-lts.1",
    "newman": "^6.2.3",
    "nodemailer": "^10.6.0",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
